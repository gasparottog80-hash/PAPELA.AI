# Copy to an untracked .env.production OUTSIDE Git after provisioning a VPS.
# Values here are paths and placeholders, never credentials. Do not start this
# example unchanged. Compose intentionally fails if mandatory values are empty.
PAPELA_PROJECT_NAME=papela-production
PAPELA_DOMAIN=REPLACE_WITH_PUBLIC_FQDN.invalid
PAPELA_APP_IMAGE=papelaai:gate4
PAPELA_MAX_STORAGE_BYTES=536870912
PAPELA_LOG_MAX_SIZE=10m
PAPELA_LOG_MAX_FILES=3
PAPELA_BACKUP_DIR=/srv/papela/backups
PAPELA_BACKUP_RETENTION_DAYS=30
PAPELA_ERASURE_DIR=/srv/papela/erasures
PAPELA_JOB_RETENTION_DAYS=30
PAPELA_HTTP_BIND=0.0.0.0
PAPELA_HTTP_PORT=80
PAPELA_HTTPS_BIND=0.0.0.0
PAPELA_HTTPS_PORT=443
PAPELA_PG_ADMIN_PASSWORD_FILE=/etc/papela/secrets/pg_admin_password
PAPELA_PG_RUNTIME_PASSWORD_FILE=/etc/papela/secrets/pg_runtime_password
PAPELA_DATABASE_URL_FILE=/etc/papela/secrets/app_database_url
PAPELA_TENANT_API_KEYS_FILE=/etc/papela/secrets/tenant_api_keys
