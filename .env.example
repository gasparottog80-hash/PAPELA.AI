# Copy to .env and adjust. NEVER commit real keys.
PAPELA_ENV=development
PAPELA_LOG_LEVEL=INFO
PAPELA_DATABASE_URL=postgresql://papela:papela@localhost:5433/papela
PAPELA_STORAGE_DIR=./data/uploads
PAPELA_API_KEYS=dev-key-change-me
PAPELA_RATE_LIMIT_PER_MIN=60
# ocr_engine: "fake" (no model download) or "paddle" (needs the `ocr` extra)
PAPELA_OCR_ENGINE=fake
PAPELA_OCR_LANG=pt
