{
	admin off
	# Runtime proxy errors may include the request object. Drop all incoming
	# headers from Caddy logs so tenant API keys cannot appear in diagnostics.
	log {
		format filter {
			request>headers delete
		}
	}
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 40s
			write 30s
			idle 30s
		}
	}
}

{$PAPELA_DOMAIN} {
	request_body {
		max_size 22MiB
	}
	header {
		>X-Content-Type-Options nosniff
		>Referrer-Policy no-referrer
		>X-Frame-Options DENY
		>Strict-Transport-Security "max-age=31536000"
		>Cache-Control no-store
	}
	reverse_proxy api:8000 {
		health_uri /readiness
		health_headers {
			Host {$PAPELA_DOMAIN}
		}
		health_interval 10s
		health_timeout 2s
		transport http {
			dial_timeout 3s
			response_header_timeout 35s
		}
	}
}
